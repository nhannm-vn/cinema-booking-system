{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Firebase Emulator",
      "type": "shell",
      "command": "firebase emulators:start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting emulators...",
          "endsPattern": "All emulators ready!"
        }
      }
    }
  ]
}
